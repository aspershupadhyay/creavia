// Creavia Cloud on Cloudflare Workers. Built by OpenNext (`npm run build:worker`), deployed by `npm run deploy` (Deploy to
// Cloudflare, `npm run setup`, or .github/workflows/cloud.yml). Secrets live on the Worker, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creavia-cloud",
  "main": ".open-next/worker.js",
  // your own Cloudflare account (one click, or `npm run setup`: docs/DEPLOY.md); served at its workers.dev address
  // until you add a custom domain (then set APP_URL to it)
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // the studio's bucket, reached from inside Cloudflare (lib/store.ts); presigned links still use the S3 API
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "creavia" }],
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true }
}
