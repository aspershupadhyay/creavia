{
  "name": "@creavia/cloud",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "schema": "node scripts/gen-schema.mjs",
    "setup": "node scripts/deploy.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@neon/realtime": "^0.2.1",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/cloudflare": "^11.12.0",
    "@sentry/nextjs": "^11.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "aws4fetch": "^1.0.20",
    "docx-preview": "0.4.1",
    "mcp-handler": "^2.3.0",
    "next": "^16.4.3",
    "pdfjs-dist": "6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "ws": "^8.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "3.2.7",
    "wrangler": "^4.156.0"
  },
  "cloudflare": {
    "label": "Creavia Cloud",
    "products": [
      "Workers",
      "R2"
    ],
    "categories": [
      "storage"
    ],
    "icon_urls": [
      "https://raw.githubusercontent.com/aspershupadhyay/creavia/main/brand/icon.svg"
    ],
    "preview_image_url": "https://raw.githubusercontent.com/aspershupadhyay/creavia/main/brand/icon-1024.png",
    "publish": true,
    "bindings": {
      "BUCKET": {
        "description": "Where the studio keeps files, voices and its own state."
      },
      "MCP_TOKEN": {
        "description": "The studio's master key: 24+ random characters. Keep it: the desktop app's token sign-in and scripts use it."
      },
      "WORKER_SECRET": {
        "description": "24+ random characters, shared with your GPU workers (Colab, Kaggle, Modal, or the Creavia app's engine)."
      },
      "DATABASE_URL": {
        "description": "Your Neon Postgres connection string (postgres://\u2026). Free at neon.tech."
      }
    }
  }
}
